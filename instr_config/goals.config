baseline_file_verified = boolean : ( _base and _base_file )
unauthorized_change_verified = boolean : ( _tamper and _soc_state )
soc_evidence_collection_verified = boolean : ( _soc_state and _soc_hash )
soc_detection_verified = count_greater : 0 : ( _alert )
file_recovery_verified = boolean : ( _restore and _final_file and _verified )
