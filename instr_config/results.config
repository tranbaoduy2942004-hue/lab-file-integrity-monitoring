_base = linux-host:fim-lab/actions.log : FILE_REGEX : BASELINE_CREATED
_base_file = linux-host:fim-lab/baseline.conf : FILE_REGEX : audit=enabled
_tamper = linux-host:fim-lab/actions.log : FILE_REGEX : UNAUTHORIZED_CHANGE
_soc_state = soc:fim-lab/state.json : FILE_REGEX : audit=disabled
_soc_hash = soc:fim-lab/state.json : FILE_REGEX : current_hash
_alert = soc:fim-lab/alerts.log : FILE_REGEX : FIM_UNAUTHORIZED_CHANGE_DETECTED
_restore = linux-host:fim-lab/actions.log : FILE_REGEX : FILE_RESTORED
_final_file = linux-host:fim-lab/app.conf : FILE_REGEX : audit=enabled
_verified = soc:fim-lab/response.log : FILE_REGEX : FIM_RECOVERY_VERIFIED
